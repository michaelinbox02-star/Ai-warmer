# ---------------------------------------------------------------------------
# Copy to `.env` and fill in every value. Never commit `.env`.
#
# Generate secrets with the API virtualenv, for example:
#   .\.venv\Scripts\python.exe -m app.cli gen-key          # Fernet vault key
#   .\.venv\Scripts\python.exe -m app.cli gen-token        # session secret / API token
#   .\.venv\Scripts\python.exe -m app.cli hash-password    # operator password hash
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# Public URL of the operator console. HTTPS is required outside loopback.
PUBLIC_BASE_URL=http://localhost:3000
# Set only if you serve the UI from an additional origin.
# EXTRA_ALLOWED_ORIGINS=["https://console.example.com"]
# API self-URL used by local tooling (the web rewrite uses its own value).
# API_INTERNAL_URL=http://localhost:8000

# --- PostgreSQL ------------------------------------------------------------
# Used by docker-compose for the `db` service.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Used by the API and worker when they run on the host. Inside Compose this is
# overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://deliverability:change-me-to-a-long-random-password@localhost:5432/deliverability
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000
# Standard PostgreSQL accepts UTC. Use GMT only with stripped-down local builds
# that omit the zoneinfo database.
DB_TIMEZONE=UTC

# --- Operator authentication ----------------------------------------------
# Exactly one of ADMIN_PASSWORD_HASH or ADMIN_PASSWORD is required.
# Prefer the hash: run `python -m app.cli hash-password`.
ADMIN_PASSWORD_HASH=
# Plain text is accepted for local development only; production requires >=12 chars.
ADMIN_PASSWORD=
# HMAC key for the signed session cookie. At least 32 characters.
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Brute-force protection for the single operator login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Optional bearer token for local automation. Leave empty to disable.
API_TOKEN=
# Required only for the local provider-event relay endpoint. Empty disables it.
EVENT_INGEST_TOKEN=

# --- Secret storage --------------------------------------------------------
SECRET_BACKEND=encrypted_local_vault
# Host development default. Docker Compose overrides this to /data/secrets.
VAULT_DIR=./var/secrets
# Fernet key. Generate with `python -m app.cli gen-key`.
# Back this up separately from the database; without it stored tokens are lost.
VAULT_MASTER_KEY=
# Used only when SECRET_BACKEND=docker_secret.
DOCKER_SECRET_DIR=/run/secrets

# --- OAuth providers (leave empty to disable that provider) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common`, `organizations`, `consumers`, or a tenant id.
MICROSOFT_TENANT=common

# --- Worker ----------------------------------------------------------------
# WORKER_ID defaults to worker-<random> and must be unique per worker process.
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=120
WORKER_SEND_TIMEOUT_SECONDS=45
WORKER_HOUSEKEEPING_SECONDS=30

# --- Sending defaults ------------------------------------------------------
# Conservative defaults; override per account in the console.
MAX_ACCOUNTS=5
DEFAULT_MAX_PER_MINUTE=3
DEFAULT_MAX_ROLLING_24H=25
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_MAX_IN_FLIGHT=1
MAX_MESSAGE_BYTES=1048576
# Optional delay before a queued message becomes eligible (0 = immediate).
SCHEDULED_GRACE_SECONDS=0
# API-level send rate limit per operator session/token, per minute.
SEND_RATE_LIMIT_PER_MINUTE=30

# --- Diagnostics -----------------------------------------------------------
DNS_TIMEOUT_SECONDS=5.0
DNS_CHECK_TTL_SECONDS=86400

# --- Optional AI diagnostics (advisory only; never sends or changes state) --
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=1200

# --- Retention -------------------------------------------------------------
RETENTION_BODY_DAYS=30
RETENTION_EVENT_DAYS=90
RETENTION_AUDIT_DAYS=180

# --- Backup utility --------------------------------------------------------
# Passphrase used by scripts/backup.py and scripts/restore.py. If empty the
# scripts prompt interactively. Keep it out of shell history.
DLP_BACKUP_PASSPHRASE=
